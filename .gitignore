# -----------------------------------------------------------------------------
# DVC-managed data and local DVC state
# Keep DVC metadata, pointers, and lock files in Git.
# -----------------------------------------------------------------------------

.dvc/cache/
.dvc/tmp/
.dvc/config.local

data/raw/
data/processed/
data/interim/
data/external/
data/downloads/

# Downloaded dataset archives
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.tgz

# -----------------------------------------------------------------------------
# ML training and experiment output
# -----------------------------------------------------------------------------

# Local MLflow run directories can grow without bound. The portable SQLite
# database and curated evidence included with this assignment remain trackable.
mlruns/
mlartifacts/

# DVC owns mutable training/evaluation outputs. The promoted, checksum-protected
# release under artifacts/release is intentionally committed.
artifacts/model/*.pt
artifacts/model/*.pth
artifacts/model/*.ckpt
artifacts/model/*.onnx
artifacts/model/*.h5
artifacts/model/*.pkl
artifacts/model/*.joblib
artifacts/evaluation/*

# Runtime monitoring output is local except for the curated grading report.
monitoring/reports/*.json
!monitoring/reports/post_deployment_metrics.json

# -----------------------------------------------------------------------------
# Assignment deliverables that must remain eligible for Git tracking
# -----------------------------------------------------------------------------

!.env.example
!.dvc/config
!.dvcignore
!data/raw.dvc
!dvc.lock
!mlflow.db
!artifacts/release/
!artifacts/release/**
!evidence/
!evidence/**

# Local submission archives are uploaded to the LMS, not committed to Git.
dist/
